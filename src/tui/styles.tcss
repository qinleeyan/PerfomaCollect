Screen {
    background: $surface;
}

#header-card {
    dock: top;
    height: 5;
    background: $primary-background;
    color: $text;
    content-align: center middle;
    text-style: bold;
    border-bottom: solid $primary;
}

ModelSetupScreen #header-card,
ViewConfigScreen #header-card {
    height: 3;
}

.status-badge-ok {
    color: $success;
    text-style: bold;
}

.status-badge-missing {
    color: $error;
    text-style: bold;
}

.menu-button {
    width: 100%;
    margin-bottom: 1;
}

.form-container {
    width: 80%;
    margin: 1 2;
    padding: 1 2;
    border: solid $accent;
    background: $surface-darken-1;
    overflow-y: auto;
}

.form-label {
    margin-top: 1;
    color: $text-muted;
}

.button-row {
    height: auto;
    margin-top: 1;
    align: center middle;
}

.button-row Button {
    margin-right: 1;
}

#test-result-label {
    margin-top: 1;
    height: auto;
}
